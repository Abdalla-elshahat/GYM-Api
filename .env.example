PORT=4000
NODE_ENV=development

# Secret used to sign/verify JWTs. Must be a long, random value.
# NEVER commit the real value — .env is gitignored, keep it that way.
jwtsecret=

DB_DATABASE=
DB_HOST=
DB_USERNAME=
DB_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:4200 if not set.
CORS_ORIGIN=http://localhost:4200
